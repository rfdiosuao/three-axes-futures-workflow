# ============================================================
# 三板斧期货工作流 · 环境变量配置模板
# 用法：复制为 .env 并填入你自己的值；或 export 到你的 shell / 调度器。
#   cp .env.example .env  && 编辑 .env
# 注意：.env 已在 .gitignore 排除，不会被提交。
# 所有 ID 都不是凭证（凭证由 panda / lark CLI 各自管理），但属于你的个人资源，请勿公开。
# ============================================================

# ---- 飞书（lark-cli）相关资源 ----
# 推送日报/预警的飞书群 ID（群设置里可获取，形如 oc_xxxxxxxx）
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxx
# 三板斧 Base 的 base_token（多维表格 URL 中 /base/ 后那段）
LARK_BASE_TOKEN=bascnxxxxxxxxxxxxxxxx
# 「品种信号看板」表的 table_id（URL 中 ?table= 后那段）
LARK_DASHBOARD_TABLE_ID=tblxxxxxxxxxxxx
# 「每日报告」索引表的 table_id
LARK_INDEX_TABLE_ID=tblxxxxxxxxxxxx

# ---- PandaAI 期货仿真账户 ----
# 你要监控的仿真账户 ID（防止误监控其他账户）
PANDA_ACCOUNT_ID=xxxxxxxx

# ---- 账户参数（按你的实际情况修改；脚本默认值见各脚本）----
# 账户权益（用于以损定量与风险分级）；留空则脚本尝试用 panda 实时读取，失败回退 500 万
ACCOUNT_EQUITY=5000000
